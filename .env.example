# ===== Server =====
PORT=3000
# URL public của server (https, không có dấu / ở cuối). VD: https://notify.shopcuaanh.vn
PUBLIC_URL=https://your-domain.com

# ===== Haravan (Partner app) =====
HARAVAN_APP_ID=
HARAVAN_APP_SECRET=
# Chuỗi tự đặt, khai báo giống hệt trong mục Webhook của app trên Haravan Partner
HARAVAN_VERIFY_TOKEN=dat-mot-chuoi-bat-ky
# Scope khi shop cài app (cần com.read_orders + wh_api để nhận webhook đơn hàng)
HARAVAN_SCOPES=openid profile email org userinfo com.read_orders wh_api

# ===== Lark =====
LARK_APP_ID=
LARK_APP_SECRET=
# Lark quốc tế: https://open.larksuite.com  |  Feishu (Trung Quốc): https://open.feishu.cn
LARK_DOMAIN=https://open.larksuite.com
# Nơi nhận thông báo: chat_id nhóm (oc_xxx, chạy `npm run list-chats` để lấy), hoặc email / open_id (ou_xxx) để nhắn riêng 1 người
LARK_CHAT_ID=
# (Tuỳ chọn) domain admin của shop để card có nút "Xem đơn". VD: shopcuaanh.myharavan.com
HARAVAN_SHOP_DOMAIN=

# Private token Haravan (Ứng dụng riêng, quyền đọc đơn hàng). Có token thì app tự quét đơn mới,
# không cần webhook / cài app Partner. Cũng dùng cho `npm run demo-orders`.
HARAVAN_ACCESS_TOKEN=
# Bao lâu quét 1 lần (giây, tối thiểu 15)
POLL_INTERVAL_SECONDS=60
# Thêm shop khác: mỗi shop 1 private token, đuôi tên viết HOA không dấu (vd NEWLITE)
# SHOP_NAME=KingCom
# HARAVAN_ACCESS_TOKEN_NEWLITE=
# SHOP_NAME_NEWLITE=NewLite
# HARAVAN_SHOP_DOMAIN_NEWLITE=
